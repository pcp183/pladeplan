# Clerk — https://dashboard.clerk.com/~/api-keys
# Publishable key is safe in the browser. Never commit the secret key.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Neon Postgres (Vercel Marketplace: vercel integration add neon)
# The app also accepts POSTGRES_URL if DATABASE_URL is unset.
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Optional. Shown on /privatliv. Leave empty to show the GitHub repository as contact.
PLADEPLAN_CONTACT_EMAIL=

# Stripe — https://dashboard.stripe.com/apikeys
# Leave these blank to keep «Pro kommer snart»: no price and no checkout.
# Test keys (sk_test_ / pk_test_) and live keys both work. The secret and the
# publishable key must be the same mode. Price IDs must belong to that mode.
# Hosted Checkout does not put the publishable key in the browser; it still has
# to be set, and it must match the secret, before Pro can be bought.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# price_... from a recurring monthly and/or yearly price. One of them is enough.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
